# =============================================================================
# KISAN MITRA — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# "From Farm to Market, Direct." — SIH 2026
# =============================================================================
# Copy this file to `.env` or `.env.local` and substitute with your credentials.
# NEVER commit your actual `.env` file to version control.

# -----------------------------------------------------------------------------
# 1. Firebase Web Configuration
# -----------------------------------------------------------------------------
# Obtain from: Firebase Console -> Project Settings -> General -> Your Apps (Web)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# -----------------------------------------------------------------------------
# 2. Cloudinary Media Storage (Produce & Profile Images)
# -----------------------------------------------------------------------------
# Obtain from: Cloudinary Console -> Settings -> Upload Presets (Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=YOUR_UNSIGNED_UPLOAD_PRESET

# -----------------------------------------------------------------------------
# 3. Application Metadata
# -----------------------------------------------------------------------------
VITE_APP_NAME=KisanMitra
VITE_APP_BASE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# 4. Payment Gateway (Razorpay)
# -----------------------------------------------------------------------------
# Obtain from: Razorpay Dashboard -> Settings -> API Keys (Test Key ID)
VITE_RAZORPAY_TEST_KEY=rzp_test_YOUR_KEY_ID

# -----------------------------------------------------------------------------
# 5. Mitra Multilingual Voice Assistant (Gemini AI)
# -----------------------------------------------------------------------------
# Obtain from: Google AI Studio (https://aistudio.google.com/)
# NOTE: For development/prototype, VITE_GEMINI_API_KEY is read by client.
# For production deployment, route prompts through Firebase Cloud Functions:
# GEMINI_API_KEY=YOUR_SERVER_SIDE_GEMINI_KEY
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
