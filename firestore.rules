rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isFarmer() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'farmer';
    }

    function isBuyer() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'buyer';
    }

    function isActiveUser() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Check that no protected fields are being changed
    function notChangingProtectedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['uid', 'role', 'status', 'isEmailVerified', 'createdAt']);
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      // User can read their own document; admin can read all
      allow read: if isCurrentUser(userId) || isAdmin();

      // New user document can only be created for themselves at registration
      allow create: if isCurrentUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['farmer', 'buyer']  // cannot self-assign admin
        && request.resource.data.status == 'active';

      // User can update their own profile but not sensitive fields
      allow update: if (isCurrentUser(userId) && notChangingProtectedUserFields())
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ─── Farmers ─────────────────────────────────────────────────────────────
    match /farmers/{farmerId} {
      // Anyone can read verified farmer profiles (public marketplace)
      allow read: if resource.data.verificationStatus == 'verified'
        || isCurrentUser(farmerId)
        || isAdmin();

      // Only the farmer themselves can create their profile
      allow create: if isCurrentUser(farmerId)
        && isFarmer()
        && isActiveUser()
        && request.resource.data.userId == farmerId
        // Cannot self-verify
        && request.resource.data.verificationStatus == 'not_started';

      // Farmer can update own profile (not verificationStatus); admin can update all fields
      allow update: if (isCurrentUser(farmerId)
          && isActiveUser()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['verificationStatus', 'userId', 'createdAt']))
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ─── Farms ───────────────────────────────────────────────────────────────
    match /farms/{farmId} {
      allow read: if true;  // Farms are public info

      allow create: if isFarmer()
        && isActiveUser()
        && request.resource.data.farmerId == request.auth.uid;

      allow update: if isFarmer()
        && isActiveUser()
        && resource.data.farmerId == request.auth.uid
        && request.resource.data.farmerId == request.auth.uid;  // Cannot change ownership

      allow delete: if (isFarmer() && resource.data.farmerId == request.auth.uid)
        || isAdmin();
    }

    // ─── Products ────────────────────────────────────────────────────────────
    match /products/{productId} {
      // Public can read active/available products
      allow read: if resource.data.availabilityStatus in ['available', 'limited']
        || (isAuthenticated() && resource.data.farmerId == request.auth.uid)
        || isAdmin();

      // Only the owning farmer can create a product
      allow create: if isFarmer()
        && isActiveUser()
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.currency == 'INR'
        && request.resource.data.price > 0
        && request.resource.data.quantity > 0;

      // Farmer can update their own product; cannot change farmerId or currency
      allow update: if (isFarmer()
          && isActiveUser()
          && resource.data.farmerId == request.auth.uid
          && request.resource.data.farmerId == request.auth.uid
          && request.resource.data.currency == 'INR')
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ─── Categories ──────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Orders ──────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Buyer and farmer involved can read the order; admin can read all
      allow read: if (isAuthenticated() &&
          (resource.data.buyerId == request.auth.uid ||
           resource.data.farmerId == request.auth.uid))
        || isAdmin();

      // Only active buyers can create orders
      allow create: if isBuyer()
        && isActiveUser()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.orderStatus == 'pending'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.currency == 'INR'
        && request.resource.data.total > 0;

      // Status updates: only parties involved can update, not arbitrary fields
      allow update: if isAuthenticated()
        && (resource.data.buyerId == request.auth.uid ||
            resource.data.farmerId == request.auth.uid)
        // Protect ownership fields
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.farmerId == resource.data.farmerId
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total
        && request.resource.data.currency == resource.data.currency
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ─── Inventory ───────────────────────────────────────────────────────────
    match /inventory/{productId} {
      // Farmer can read/write their own inventory; admin can read all
      allow read: if (isAuthenticated() && resource.data.farmerId == request.auth.uid)
        || isAdmin();

      allow create: if isFarmer()
        && request.resource.data.farmerId == request.auth.uid;

      allow update: if (isFarmer() && resource.data.farmerId == request.auth.uid
          && request.resource.data.farmerId == request.auth.uid)
        || isAdmin()
        || (isBuyer() && isActiveUser()); // Buyers can trigger reserve (server validates amount)

      allow delete: if isAdmin();
    }

    // ─── Favorites ───────────────────────────────────────────────────────────
    match /favorites/{favoriteId} {
      allow read:   if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow update: if false;  // Favorites are immutable; delete and recreate
    }

    // ─── Notifications ───────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() || isAdmin(); // System creates notifications
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        // Only isRead field can be updated by user
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin();
    }

    // ─── Market Prices ───────────────────────────────────────────────────────
    match /marketPrices/{priceId} {
      allow read:  if true;   // Public reference data
      allow write: if isAdmin();
    }

    // ─── Reports ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read:   if (isAuthenticated() && resource.data.reporterId == request.auth.uid)
        || isAdmin();
      allow create: if isAuthenticated()
        && isActiveUser()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Buyers ──────────────────────────────────────────────────────────────
    match /buyers/{buyerId} {
      allow read:   if isCurrentUser(buyerId) || isAdmin();
      allow create: if isCurrentUser(buyerId) && isBuyer();
      allow update: if isCurrentUser(buyerId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['userId', 'createdAt'])
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
